{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crawl-cheap-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Serve only the custom domain; the *.workers.dev route stays disabled in prod.
  "workers_dev": false,
  "preview_urls": false,

  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "DEMO_MODE": "true",
    "SERVICE_ORIGIN": "https://crawl-cheap-api.manhattan.workers.dev",
    "USER_AGENT": "crawlcheapbot/0.1 (+https://crawl.cheap/bot)",
    "SEARCH_PROVIDER": "exa",
    "WEBHOOK_SECRET": "whsec_crawlcheap_demo_override_in_prod",
  },

  "ai": { "binding": "AI" },

  "browser": { "binding": "BROWSER" },

  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "crawl-cheap-artifacts" }],

  "vectorize": [{ "binding": "VECTORIZE", "index_name": "crawl-cheap-rag" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crawl-cheap",
      "database_id": "928ae85c-221a-4c65-8bee-5ce4322b308b",
      "migrations_dir": "migrations",
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "CRAWL", "class_name": "CrawlCoordinator" },
      { "name": "EXTRACT", "class_name": "ExtractCoordinator" },
      { "name": "BROWSER_SESSION", "class_name": "BrowserSession" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CrawlCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["ExtractCoordinator"] },
    { "tag": "v3", "new_sqlite_classes": ["BrowserSession"] },
  ],

  // --- Optional bindings (uncomment + provision to enable higher tiers) ---
  //
  // Browser Rendering (JS-rendered scrape, screenshots, AI /json extraction):
  //   "browser": { "binding": "BROWSER" }
  //
  // Workers AI (AI extraction / summary):
  //   "ai": { "binding": "AI" }
  //
  // D1 (API keys, credit ledger, job metadata) — see migrations/:
  //   "d1_databases": [{ "binding": "DB", "database_name": "crawl-cheap", "database_id": "<uuid>" }]
  //
  // R2 (crawl artifacts, screenshots, result bundles):
  //   "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "crawl-cheap-artifacts" }]
  //
  // Queues (async batch orchestration):
  //   "queues": { "producers": [{ "binding": "CRAWL_QUEUE", "queue": "crawl-cheap-crawl" }] }
}
