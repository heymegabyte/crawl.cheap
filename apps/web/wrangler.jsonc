{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crawl-cheap-web",
  "compatibility_date": "2026-09-23",
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  // Serve only the custom domain; the *.workers.dev route stays disabled in prod.
  "workers_dev": false,
  "preview_urls": false,
  // Custom domains `crawl.cheap` + `www.crawl.cheap` are attached to this Worker.
}
