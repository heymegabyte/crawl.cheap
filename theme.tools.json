{
  "schemaVersion": "1.0.0",
  "siteId": "crawl.cheap",
  "domain": "crawl.cheap",
  "theme": {
    "id": "midnight-cyan",
    "tokenStandard": "W3C DTCG 2025.10 OKLCH",
    "background": "#060610",
    "backgroundOklch": "oklch(11% 0.02 275)",
    "primary": "#00E5FF",
    "primaryOklch": "oklch(84% 0.17 198)",
    "secondary": "#FF8A3D",
    "secondaryOklch": "oklch(72% 0.19 42)",
    "transition": "0.333s cubic-bezier(0.22, 1, 0.36, 1)",
    "interactionStates": 16,
    "tactileMicroInteractions": 30
  },
  "observability": {
    "package": "@theme.tools/telemetry",
    "correlationHeader": "traceparent",
    "langfuseTimeoutMs": 2500,
    "langfuseCircuitBreakerStrikes": 3,
    "langfuseCooldownMs": 60000,
    "rails": ["cloudflare", "sentry", "posthog", "ga4", "gtm", "langfuse", "promptfoo"]
  },
  "bindings": [
    {
      "package": "@theme.tools/themes",
      "version": "workspace:*",
      "tier": 1,
      "surface": "oklch-tokens-42-themes-16-states"
